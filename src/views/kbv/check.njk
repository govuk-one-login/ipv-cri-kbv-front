{% extends "base-form.njk" %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "components/onPageLoad/macro.njk" import ga4OnPageLoad %}
{% from "frontend-ui/build/components/form/macro.njk" import form %}
{% from "frontend-ui/build/components/submit/macro.njk" import submit %}

{% set hmpoPageKey = "check" %}
{% set gtmJourney = "kbv - start" %}

{% block mainContent %}

<h1 id="header" class="govuk-heading-l">{{translate("pages.check.title")}}</h1>

{% call form(ctx) %}

{{ html(translate("pages.check.content")) }}

{{ govukDetails({
summaryText: translate("pages.check.details.title"),
html: html(translate("pages.check.details.content"))
}) }}

{{ submit(ctx, {attributes: {"data-nav": true, "data-link": "/undefined"}, text: translate("buttons.next")}) }}

{% endcall %}

{{ ga4OnPageLoad({
  nonce: cspNonce,
  statusCode: '200',
  englishPageTitle: 'pages.check.title' | translate,
  taxonomyLevel1: 'web cri',
  taxonomyLevel2: 'kbv',
  contentId: 'undefined',
  loggedInStatus: true,
  dynamic: false
}) }}

{% endblock %}
